#
# ======================================================
# 360T7 (MT7981) 性能优化配置 ImmortalWrt 25.12 kernel6.12
# 修复：大页内存坑、openssl chacha优先废掉AES硬件加速
# 内置 HomeProxy + Sing‑Box 1.14 / SmartDNS / Argon
# ======================================================
#

# ========== 目标平台 ==========
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_qihoo_360t7=y

# ========== 内核基础 ==========
CONFIG_LINUX_6_12=y
CONFIG_KERNEL_BUILD_USER=""
CONFIG_KERNEL_BUILD_DOMAIN=""
CONFIG_USE_CCACHE=y
CONFIG_CCACHE_DIR="/home/runner/.ccache"

# ========== 性能编译优化【已修复风险项】 ==========
CONFIG_TARGET_OPTIMIZATION="-O3 -pipe -mcpu=cortex-a53+fp+simd+crypto -mtune=cortex-a53 -fstack-protector -fno-plt"
CONFIG_USE_LTO=y
# CONFIG_GRAPHITE=y
CONFIG_PREEMPT=y
CONFIG_TRANSPARENT_HUGEPAGE=y
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_COMPACTION=y
CONFIG_NET_RPS=y
CONFIG_NET_XPS=y
CONFIG_BQL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ========== MT7981 PPE硬件NAT全套开启 ==========
CONFIG_NET_MEDIATEK_SOC=y
CONFIG_NET_MEDIATEK_PPE=y
CONFIG_NET_MEDIATEK_PPE_ETH=y
CONFIG_NET_MEDIATEK_PPE_V2=y
CONFIG_NET_MEDIATEK_PPE_QDMA=y
CONFIG_NET_MEDIATEK_PPE_DEBUG=n

# ========== 文件系统 360T7标准 ==========
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_SQUASHFS_XZ=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ========== 关闭内核调试，缩小固件 ==========
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_KERNEL=n
CONFIG_KERNEL_DEBUG_INFO=n
CONFIG_KERNEL_DEBUG_LL=n

# ========== 核心插件 ==========
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_homeproxy=y
CONFIG_PACKAGE_sing-box=y

# ========== LuCI界面&中文 ==========
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-compat=y

# ========== 网络工具 ==========
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_nmap=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_iperf3=y

# ========== OpenSSL 启用AES硬件加速，移除无用国密算法 ==========
CONFIG_PACKAGE_openssl-util=y
CONFIG_OPENSSL_ENGINE=y
# CONFIG_OPENSSL_PREFER_CHACHA_OVER_AES=y
CONFIG_OPENSSL_WITH_ASM=y
CONFIG_OPENSSL_WITH_CAMELLIA=n
CONFIG_OPENSSL_WITH_IDEA=n
CONFIG_OPENSSL_WITH_MDC2=n
CONFIG_OPENSSL_WITH_SEED=n
CONFIG_OPENSSL_WITH_SM2=n
CONFIG_OPENSSL_WITH_SM3=n
CONFIG_OPENSSL_WITH_SM4=n

# ========== DNS & SSH ==========
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq-full_DNSSEC=y
CONFIG_PACKAGE_dnsmasq-full_IPSET=y
CONFIG_PACKAGE_dnsmasq-full_NETWORK=y
CONFIG_PACKAGE_openssh-sftp-server=y

# ========== 系统版本标识 ==========
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="ImmortalWrt"
CONFIG_VERSION_REPO="https://downloads.immortalwrt.org"
CONFIG_VERSION_NUMBER="25.12"
CONFIG_VERSION_CODE=""

# ========== 编译并发，Github Action限制内存，固定‑j4 ==========
CONFIG_MAKE_JOBS="-j4"

# ========== 关闭无用编译目标 ==========
CONFIG_GRUB_IMAGES=n
CONFIG_PARTED_IMAGES=n
