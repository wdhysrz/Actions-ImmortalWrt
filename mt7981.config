CONFIG_HAS_SUBTARGETS=y
CONFIG_HAS_DEVICES=y
CONFIG_TARGET_BOARD="mediatek"
CONFIG_TARGET_SUBTARGET="filogic"
CONFIG_TARGET_PROFILE="DEVICE_qihoo_360t7"

# ========== 内核基础 ==========
CONFIG_LINUX_6_12=y
CONFIG_KERNEL_BUILD_USER=""
CONFIG_KERNEL_BUILD_DOMAIN=""
CONFIG_USE_CCACHE=y
CONFIG_CCACHE_DIR="/home/runner/.ccache"

# ========== 编译优化【GitHub Action环境！！O2，关闭LTO，防止OOM内存溢出】 ==========
CONFIG_TARGET_OPTIMIZATION="-O3 -pipe -mcpu=cortex‑a53+fp+simd+crypto -mtune=cortex‑a53 -fstack‑protector -fno‑plt"
CONFIG_USE_LTO=n
# CONFIG_GRAPHITE=y # Action内存不够，保持注释；本地WSL大内存再打开

CONFIG_PREEMPT=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_COMPACTION=y
CONFIG_NET_RPS=y
CONFIG_NET_XPS=y
CONFIG_BQL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ========== MT7981 PPE硬件NAT全套开启 ==========
CONFIG_NET_MEDIATEK_SOC=y
CONFIG_NET_MEDIATEK_PPE=y
CONFIG_NET_MEDIATEK_PPE_ETH=y
CONFIG_NET_MEDIATEK_PPE_V2=y
CONFIG_NET_MEDIATEK_PPE_QDMA=y
CONFIG_NET_MEDIATEK_PPE_DEBUG=n

# ========== 文件系统 360T7标准 ==========
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_SQUASHFS_XZ=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ========== 关闭内核调试，缩小固件 ==========
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_KERNEL=n
CONFIG_KERNEL_DEBUG_INFO=n
CONFIG_KERNEL_DEBUG_LL=n

# ========== 核心插件 ==========
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_homeproxy=y
CONFIG_PACKAGE_sing‑box=y

# ========== LuCI界面&中文 ==========
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci‑theme‑argon=y
CONFIG_PACKAGE_luci‑i18n‑base‑zh‑cn=y
CONFIG_PACKAGE_luci‑i18n‑firewall‑zh‑cn=y
CONFIG_PACKAGE_luci‑ssl‑openssl=y
CONFIG_PACKAGE_luci‑compat=y

# ========== 网络工具 ==========
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_nmap=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_iperf3=y

# ========== OpenSSL AES硬件加速，关闭chacha优先 ==========
CONFIG_PACKAGE_openssl‑util=y
CONFIG_OPENSSL_ENGINE=y
# CONFIG_OPENSSL_PREFER_CHACHA_OVER_AES=y
CONFIG_OPENSSL_WITH_ASM=y
CONFIG_OPENSSL_WITH_CAMELLIA=n
CONFIG_OPENSSL_WITH_IDEA=n
CONFIG_OPENSSL_WITH_MDC2=n
CONFIG_OPENSSL_WITH_SEED=n
CONFIG_OPENSSL_WITH_SM2=n
CONFIG_OPENSSL_WITH_SM3=n
CONFIG_OPENSSL_WITH_SM4=n

# ========== DNS & SSH ==========
CONFIG_PACKAGE_dnsmasq‑full=y
CONFIG_PACKAGE_dnsmasq‑full_DNSSEC=y
CONFIG_PACKAGE_dnsmasq‑full_IPSET=y
CONFIG_PACKAGE_dnsmasq‑full_NETWORK=y
CONFIG_PACKAGE_openssh‑sftp‑server=y

# ========== 系统版本标识 ==========
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="ImmortalWrt"
CONFIG_VERSION_REPO="https://downloads.immortalwrt.org"
CONFIG_VERSION_NUMBER="25.12"
CONFIG_VERSION_CODE=""

# ========== Github Action限制内存，固定‑j4 ==========
CONFIG_MAKE_JOBS="-j4"

# ========== 关闭无用编译目标 ==========
CONFIG_GRUB_IMAGES=n
CONFIG_PARTED_IMAGES=n
