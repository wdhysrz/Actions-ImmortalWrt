#
# ============================================================
# 360T7 (MT7981) 极致性能配置 + SmartDNS
# 适用于 ImmortalWrt 25.12 (内核 6.12)
# ============================================================
#

# ========== 目标平台 ==========
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_qihoo_360t7=y

# ========== 内核优化 ==========
CONFIG_LINUX_6_12=y
CONFIG_KERNEL_BUILD_USER=""
CONFIG_KERNEL_BUILD_DOMAIN=""
CONFIG_USE_CCACHE=y
CONFIG_CCACHE_DIR="/home/runner/.ccache"

# ========== 极致性能优化 ==========
CONFIG_TARGET_OPTIMIZATION="-O3 -pipe -mcpu=cortex-a53+fp+simd+crypto -mtune=cortex-a53 -fstack-protector-strong -fno-plt"
CONFIG_USE_LTO=y
CONFIG_GRAPHITE=y
CONFIG_PREEMPT=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
CONFIG_COMPACTION=y
CONFIG_NET_RPS=y
CONFIG_NET_XPS=y
CONFIG_BQL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ========== 硬件加速 (MT7981 PPE) ==========
CONFIG_NET_MEDIATEK_SOC=y
CONFIG_NET_MEDIATEK_PPE=y
CONFIG_NET_MEDIATEK_PPE_ETH=y
CONFIG_NET_MEDIATEK_PPE_V2=y
CONFIG_NET_MEDIATEK_PPE_QDMA=y
CONFIG_NET_MEDIATEK_PPE_DEBUG=n

# ========== 文件系统 ==========
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_SQUASHFS_XZ=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ========== 关闭调试（减小体积） ==========
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_KERNEL=n
CONFIG_KERNEL_DEBUG_INFO=n
CONFIG_KERNEL_DEBUG_LL=n

# ========== 核心插件：SmartDNS ==========
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y

# ========== 其他常用插件 ==========
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Brook=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ChinaDNS_NG=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Kcptun=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_PDNSD=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_None_Enc=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Trojan=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_hysteria=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_tuic_client=y

# ========== 主题 & 界面 ==========
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# ========== 网络工具 ==========
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_nmap=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_iperf3=y

# ========== 基础系统 ==========
CONFIG_GRUB_IMAGES=n
CONFIG_PARTED_IMAGES=n
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="ImmortalWrt"
CONFIG_VERSION_REPO="https://downloads.immortalwrt.org"
CONFIG_VERSION_NUMBER="25.12"
CONFIG_VERSION_CODE=""
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_OPENSSL_ENGINE=y
CONFIG_OPENSSL_PREFER_CHACHA_OVER_AES=y
CONFIG_OPENSSL_WITH_ASM=y
CONFIG_OPENSSL_WITH_CAMELLIA=y
CONFIG_OPENSSL_WITH_CMS=y
CONFIG_OPENSSL_WITH_DTLS=y
CONFIG_OPENSSL_WITH_EC2M=y
CONFIG_OPENSSL_WITH_IDEA=y
CONFIG_OPENSSL_WITH_MDC2=y
CONFIG_OPENSSL_WITH_PSK=y
CONFIG_OPENSSL_WITH_RFC3779=y
CONFIG_OPENSSL_WITH_SEED=y
CONFIG_OPENSSL_WITH_SM2=y
CONFIG_OPENSSL_WITH_SM3=y
CONFIG_OPENSSL_WITH_SM4=y
CONFIG_OPENSSL_WITH_SRP=y
CONFIG_OPENSSL_WITH_WHIRLPOOL=y

# ========== 清除不需要的包（减小体积） ==========
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq-full_DNSSEC=y
CONFIG_PACKAGE_dnsmasq-full_IPSET=y
CONFIG_PACKAGE_dnsmasq-full_NETWORK=y

CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt76-connac=y
CONFIG_PACKAGE_kmod-mt76-core=y
CONFIG_PACKAGE_kmod-mt76=y
CONFIG_PACKAGE_mt76-firmware=y

# ========== 并行编译 ==========
CONFIG_MAKE_JOBS="-j$(nproc)"